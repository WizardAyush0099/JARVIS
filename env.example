# =====================================================================
#  JARVIS configuration
#  Copy to `.env` and fill in what you have. Everything is optional:
#  JARVIS degrades gracefully and always keeps an offline fallback.
#  NEVER commit the real `.env`.
# =====================================================================

# --- identity --------------------------------------------------------
JARVIS_NAME=JARVIS
JARVIS_OWNER=Ayush              # who JARVIS works for; "who am I" answers with this
JARVIS_CREATOR=Ayush           # who built JARVIS; "who made you" answers with this
JARVIS_LANGUAGE=auto            # auto | en | hi

# --- AI providers ----------------------------------------------------
# Priority order. The first provider that answers wins; failures fall
# through to the next one. `offline` is always available and is appended
# automatically, so you never end up with a dead assistant.
#
# You do not have to list anything: any provider below that has a key is
# appended to the chain automatically, keyless and local engines are handled
# for you, and `offline` stays last. Listing a provider here only moves it up.
# (Add `ollama` here as well if you use it - or just set OLLAMA_ENABLED=true.)
AI_PROVIDERS=gemini,groq,openrouter

# Google Gemini (generous free tier)  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fast + free tier)  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (many :free models)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (optional, paid)  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Other OpenAI-compatible endpoints (Together / Cerebras / Mistral / DeepSeek)
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# NVIDIA NIM (free developer tier)  https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Hugging Face Inference Providers  https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# xAI (paid)  https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4

# SambaNova Cloud: extremely low latency, good for the plan-then-answer step.
# Its free tier is small per day, so use it as a fast fallback, not the primary.
# https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Local Ollama - works with no internet at all  https://ollama.com
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Local LM Studio - also needs no key. Load a model in LM Studio, then set
# LMSTUDIO_ENABLED=true and (optionally) the model id you have loaded.
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# Keyless cloud fallback. Pollinations needs no key at all, and it sits *after*
# every provider you have credentials for - so JARVIS still answers when every
# quota is spent. It is a shared public endpoint: anything you send it leaves
# this machine. Set POLLINATIONS_ENABLED=false and it is never called.
POLLINATIONS_ENABLED=true
POLLINATIONS_MODEL=openai

# --- AI behaviour ----------------------------------------------------
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=900
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
JARVIS_HISTORY_TURNS=12         # conversation turns kept in the prompt

# --- web search (first one that is configured is used) --------------
# `duckduckgo` needs no key at all and is the default.
SEARCH_PROVIDER=duckduckgo      # duckduckgo | tavily | brave | searxng
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
SEARCH_MAX_RESULTS=5

# --- image generation ------------------------------------------------
IMAGE_PROVIDER=pollinations     # pollinations | openai
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# --- email (SMTP) ----------------------------------------------------
# Gmail needs an *App Password*, not your normal account password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_AUTO_SEND=false           # true = skip the "should I send it?" question

# --- voice output (TTS) ---------------------------------------------
TTS_ENABLED=true
TTS_ENGINE=edge                 # edge | piper | pyttsx3 | espeak | none
TTS_VOICE_EN=en-GB-RyanNeural   # calm, deep, assistant-like
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_RATE=-8                     # percent, negative = slower/calmer
TTS_VOLUME=0.9
# Where spoken replies come out. The web console switches this to "browser"
# while it is open (and back when you close it), so you hear JARVIS on the
# device you are actually using.
#   device  = this machine's speakers   browser = the web client plays them
#   off     = never speak
JARVIS_VOICE_OUTPUT=device

# --- voice input (STT) ----------------------------------------------
STT_ENABLED=false
STT_ENGINE=google               # google | whisper | sphinx | vosk | none
STT_LANGUAGE=en-IN
STT_WAKE_WORD=jarvis
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8
VOSK_MODEL_PATH=                # e.g. ./models/vosk-model-small-en-in-0.4

# --- media control (Spotify, YouTube, VLC, anything) -----------------
# Play, pause, skip, volume and "what's playing" go through MPRIS, so JARVIS
# drives whatever the machine is playing - no account, no key, works offline.
# It needs one small package:  sudo apt install playerctl
#
# Optional: link Spotify for your Liked Songs and for starting a specific track.
# One-time setup:  .venv/bin/python scripts/spotify_auth.py
# (starting a track with Spotify's API needs a Premium account; liked songs do not)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_MARKET=                 # optional country code, e.g. IN

# --- web interface --------------------------------------------------
JARVIS_WEB_HOST=0.0.0.0         # 0.0.0.0 so your phone can reach it
JARVIS_WEB_PORT=8765
JARVIS_WEB_TOKEN=               # set to require ?token=... (recommended on LAN)
JARVIS_OPEN_BROWSER=true

# --- safety ---------------------------------------------------------
CONFIRM_DESTRUCTIVE=true        # never run shutdown/delete/mail without a yes
ALLOWED_PATHS=                  # extra comma-separated roots the file tools may touch
ALLOWED_APPS=code,chromium,firefox,terminal,vscode,spotify,vlc,calculator,settings
TOOL_TIMEOUT=30
