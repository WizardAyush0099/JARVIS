{
  "name": "JARVIS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Core requirements (FastAPI + the brain) plus edge-tts, which is pure Python
  // and needs no audio hardware: it synthesizes to a file that the browser
  // plays. That is what gives JARVIS a real voice on a machine with no speakers.
  "postCreateCommand": "python3 -m pip install -r requirements.txt && python3 -m pip install 'edge-tts>=6.1'",

  // Start the assistant in the background so the forwarded port is live as soon
  // as the container attaches. `scripts/cloud.sh` is idempotent and never tries
  // to open a browser.
  "postStartCommand": "sh scripts/cloud.sh",

  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "JARVIS console",
      "onAutoForward": "silent",
      // Public so the forwarded URL opens straight from a phone browser without
      // a GitHub login. Set JARVIS_WEB_TOKEN if you care who can reach it.
      "visibility": "public"
    }
  },

  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  }
}
